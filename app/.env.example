# 서비(Seobi) 환경변수 설정
# 이 파일을 복사해서 .env 파일을 만들고 실제 값을 입력하세요

# ========== AI 모델 ==========
# OpenAI API 사용 시
OPENAI_API_KEY=sk-...

# Anthropic Claude API 사용 시
ANTHROPIC_API_KEY=sk-ant-...

# ========== 인트라넷 연동 ==========
# 가상 기관 그룹웨어 (실제 주소는 각자 .env 에만 적습니다)
INTRANET_API_KEY=your-api-key-here
INTRANET_BASE_URL=http://127.0.0.1:8100

# 인트라넷 계정 (필요하면)
INTRANET_USER=your-id
INTRANET_PASSWORD=your-password

# ========== 이메일 ==========
# SMTP 메일 발송
MAIL_USER=seobi@example.com
MAIL_PASS=mail-password

# ========== 기타 ==========
# 로깅 레벨
LOG_LEVEL=INFO

# 로컬 개발 환경
ENVIRONMENT=development
